# Copiar a .env.e2e (ignorado por git) y ajustar. No guardar secretos aquí.

# URL del front en el entorno de pruebas. Si es localhost, Playwright levanta
# la app con `npm start` (o reutiliza el servidor si ya está corriendo).
E2E_TEST_BASE_URL=http://localhost:4200

# Cuenta de pruebas para las e2e que inician sesión de verdad (sin ellas se omiten).
# Usar una cuenta de desarrollo, nunca de producción.
E2E_USER=
E2E_PASSWORD=

# URL del front en producción. Sin valor, el project "prod" no se ejecuta.
E2E_PROD_BASE_URL=

{
  "name": "artifex",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/ensure-dev-login.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/ensure-dev-login.mjs",
    "build": "ng build --configuration production --aot",
    "prewatch": "node scripts/ensure-dev-login.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/ensure-dev-login.mjs",
    "test": "ng test",
    "pretest:ci": "node scripts/ensure-dev-login.mjs",
    "test:ci": "ng test --watch=false --karma-config=karma.ci.conf.js",
    "visual-check": "node scripts/visual-check.mjs",
    "e2e": "playwright test --project=test",
    "e2e:prod": "playwright test --project=prod",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "prettier": {
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "sideEffects": false,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.0",
    "@playwright/test": "^1.65.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.2"
  }
}
